{
  "id": "oc_collab_issue_tracker",
  "name": "oc-collab 问题追踪系统",
  "version": "1.0",
  "description": "问题发现、记录、修复、验证、关闭的完整闭环系统",
  "author": "Agent1",
  "created_at": "2026-02-10",
  "tags": ["issue", "tracking", "bug", "test", "oc-collab"],
  "triggers": [
    {
      "condition": "bug_found",
      "priority": "high"
    },
    {
      "condition": "test_failure",
      "priority": "high"
    },
    {
      "condition": "agent_asks_review",
      "priority": "medium"
    },
    {
      "condition": "before_compaction",
      "priority": "medium"
    }
  ],
  "outputs": [
    {
      "type": "file",
      "path": "state/ISSUE_INDEX.md",
      "description": "问题索引文件"
    },
    {
      "type": "directory",
      "path": "docs/issues/",
      "description": "已关闭问题归档目录"
    }
  ]
}
