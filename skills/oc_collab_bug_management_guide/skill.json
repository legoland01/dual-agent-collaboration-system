{
  "id": "oc_collab_bug_management_guide",
  "name": "OC-Collab Bug管理指南",
  "version": "v1.0.0",
  "description": "Bug处理全流程规范 - 发现、报告、分配、修复、验收、发布",
  "author": "Agent 1",
  "created_at": "2026-02-08",
  "updated_at": "2026-02-09",
  "tags": ["bug", "management", "workflow"],
  "applicable_phase": "all",
  "applicable_role": "All",
  "triggers": [
    {
      "condition": "test_failure",
      "priority": "high",
      "description": "测试失败时发现Bug"
    },
    {
      "condition": "collaboration_slow",
      "priority": "medium",
      "description": "协作不顺畅时发现流程断点"
    },
    {
      "condition": "tool_error",
      "priority": "high",
      "description": "工具返回异常时检查错误信息"
    }
  ],
  "outputs": {
    "documents": ["docs/00-memos/"],
    "artifacts": ["state/project_state.yaml"]
  },
  "related_skills": [
    "oc_collab_test_acceptance_guide",
    "oc_collab_collaboration_guide"
  ]
}
